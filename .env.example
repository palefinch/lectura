# Copy to .env.local and fill in what you have.
# The app runs in demo mode without any key.

# Meta Llama API (OpenAI-compatible endpoint).
# Leave empty to use the deterministic mock provider.
META_API_KEY=
META_API_BASE_URL=https://api.llama.com/compat/v1
META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Force the local mock even when a key is present (handy for demos).
DEMO_MODE=false

# Optional: cap the amount of text sent to the model.
MAX_INPUT_CHARS=24000
